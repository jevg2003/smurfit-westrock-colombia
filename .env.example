# Asistente de IA (solo servidor; nunca uses el prefijo NEXT_PUBLIC_).
# Orden: primero responde el proveedor principal (AI_PROVIDER). Si falla o se acaban los créditos
# (error 401, 402, 403, 429, 5xx o de red), responde el de respaldo (AI_FALLBACK_PROVIDER).
# Un proveedor solo cuenta si su clave está puesta. La búsqueda en internet funciona solo con OpenAI.
AI_PROVIDER=openai
# Modelo principal. Vacío usa gpt-4.1-mini (openai) u openai/gpt-4.1-mini (openrouter).
AI_MODEL=
# Proveedor de respaldo: "openrouter" (por defecto), "openai" o "none" para no usar respaldo.
AI_FALLBACK_PROVIDER=openrouter
# Modelo de respaldo. Vacío usa el modelo por defecto del proveedor de respaldo.
AI_FALLBACK_MODEL=
# Clave de OpenAI.
OPENAI_API_KEY=
# Clave de OpenRouter.
OPENROUTER_API_KEY=

# Server-side source flags (no NEXT_PUBLIC_ prefix: never sent to the browser).
# Each source is ON unless set to false, 0, off or no.
FEATURE_NEWS_RSS=true
# Google News RSS: terms say "personal, non-commercial use". Risk accepted by the user on 2026-10-20.
FEATURE_GOOGLE_NEWS=true
FEATURE_MINAMBIENTE=true
FEATURE_PRESIDENCIA=true

# XM (national electricity spot price). Public API without an open license declared; read on the server, ON by default.
FEATURE_XM=true
