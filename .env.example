# AI assistant (server only; never prefix these with NEXT_PUBLIC_).
# Provider: "openai" (default) or "openrouter". Built-in web search ("Buscar en internet") works with "openai" only;
# with "openrouter" the toggle is ignored and the assistant answers from the app data.
AI_PROVIDER=openai
# Optional model id. Empty uses gpt-4.1-mini (openai) or openai/gpt-4.1-mini (openrouter).
AI_MODEL=
# Key for AI_PROVIDER=openai.
OPENAI_API_KEY=
# Key for AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Server-side source flags (no NEXT_PUBLIC_ prefix: never sent to the browser).
# Each source is ON unless set to false, 0, off or no.
FEATURE_NEWS_RSS=true
# Google News RSS: terms say "personal, non-commercial use". Risk accepted by the user on 2026-10-20.
FEATURE_GOOGLE_NEWS=true
FEATURE_MINAMBIENTE=true
FEATURE_PRESIDENCIA=true
