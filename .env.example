# AI assistant (server only; never prefix these with NEXT_PUBLIC_).
# Provider: "openai" (default) or "openrouter".
AI_PROVIDER=openai
# Optional model id. Empty uses gpt-4.1-mini (openai) or openai/gpt-4.1-mini (openrouter).
AI_MODEL=
# Key for AI_PROVIDER=openai.
OPENAI_API_KEY=
# Key for AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
