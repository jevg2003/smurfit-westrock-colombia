{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "nextjs"
  ],
  "rules": {
    "react/rules-of-hooks": "error"
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "src/components/ui",
    "src/components/reui", "src/components/animate-ui"
  ]
}
